<%- include("../partials/head", { judul: judul }) %>
<body>
<%- include("../partials/header", { activePage: activePage }) %>

<main class="section" id="konten">
  <div class="container form-page">
    <p class="eyebrow">Form data produk</p>
    <h1><%= mode === "edit" ? "Edit Produk" : "Tambah Produk" %></h1>
    <p class="section-intro">Lengkapi informasi produk atau materi pendukung aksesibilitas.</p>

    <form id="produk-form" class="content-card product-form" data-mode="<%= mode %>" data-id="<%= id %>">
      <div class="form-field">
        <label for="nama">Nama produk</label>
        <input id="nama" name="nama" type="text" maxlength="120" required>
      </div>
      <div class="form-field">
        <label for="kategori">Kategori</label>
        <input id="kategori" name="kategori" type="text" maxlength="80" required>
      </div>
      <div class="form-field">
        <label for="harga">Harga (Rp)</label>
        <input id="harga" name="harga" type="number" min="0" step="100" required>
      </div>
      <div class="form-field">
        <label for="deskripsi">Deskripsi</label>
        <textarea id="deskripsi" name="deskripsi" rows="4" required></textarea>
      </div>
      <div class="action-row">
        <button id="submit-button" class="btn btn-primary-custom" type="submit">
          <%= mode === "edit" ? "Simpan Perubahan" : "Simpan Produk" %>
        </button>
        <a class="btn btn-outline-custom" href="/produk">Batal</a>
      </div>
      <p id="form-status" class="feedback-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</main>

<script src="/js/produk.js" defer></script>
<%- include("../partials/footer", { anggota: anggota }) %>
