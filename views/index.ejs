<%- include("partials/head", { judul: judul }) %>
<body>
<%- include("partials/header", { activePage: activePage }) %>

<main id="konten">
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Belajar Web Accessibility</p>
        <h1>Aksesibilitas web dimulai dari HTML yang benar.</h1>
        <p class="hero-description">
          Website ini merangkum jurnal Daniel Dang tentang penerapan prinsip
          aksesibilitas melalui HTML, CSS, dan JavaScript semantic. Pelajari
          prinsip POUR, baca ulasan jurnal, dan lihat contoh penerapannya.
        </p>
        <div class="action-row">
          <a class="btn btn-primary-custom" href="/ulasan">Baca ulasan jurnal</a>
          <a class="btn btn-outline-custom" href="/produk">Buka halaman produk</a>
        </div>
      </div>

      <figure class="hero-figure">
        <img src="/assets/hero.svg" alt="Ilustrasi tampilan website dengan empat prinsip aksesibilitas POUR.">
        <figcaption>Empat prinsip utama: Perceivable, Operable, Understandable, dan Robust.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section-soft" id="jelajahi">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Navigasi website</p>
        <h2>Jelajahi halaman</h2>
        <p>Pilih halaman atau fitur yang ingin dibuka. Semua menu utama tersedia di sini.</p>
      </div>

      <div class="navigation-grid">
        <a class="navigation-card" href="/ulasan">
          <span class="nav-number">01</span>
          <span class="nav-card-title">Ulasan Jurnal</span>
          <span class="nav-card-description">Ringkasan, prinsip POUR, teknik, dan kesimpulan jurnal.</span>
          <span class="nav-card-link">Buka halaman <span aria-hidden="true">→</span></span>
        </a>
        <a class="navigation-card" href="/produk">
          <span class="nav-number">02</span>
          <span class="nav-card-title">Kelola Produk</span>
          <span class="nav-card-description">Lihat, tambah, ubah, dan hapus data melalui database.</span>
          <span class="nav-card-link">Buka halaman <span aria-hidden="true">→</span></span>
        </a>
        <a class="navigation-card" href="/api/status" target="_blank" rel="noopener">
          <span class="nav-number">03</span>
          <span class="nav-card-title">Status API</span>
          <span class="nav-card-description">Lihat response JSON untuk memeriksa status server.</span>
          <span class="nav-card-link">Lihat endpoint <span aria-hidden="true">→</span></span>
        </a>
        <a class="navigation-card" href="/api/produk" target="_blank" rel="noopener">
          <span class="nav-number">04</span>
          <span class="nav-card-title">Data Produk API</span>
          <span class="nav-card-description">Lihat seluruh data produk dalam format JSON.</span>
          <span class="nav-card-link">Lihat endpoint <span aria-hidden="true">→</span></span>
        </a>
        <a class="navigation-card" href="#fitur">
          <span class="nav-number">05</span>
          <span class="nav-card-title">Prinsip POUR</span>
          <span class="nav-card-description">Kenali empat prinsip dasar aksesibilitas web.</span>
          <span class="nav-card-link">Lihat prinsip <span aria-hidden="true">→</span></span>
        </a>
        <a class="navigation-card" href="#kontak">
          <span class="nav-number">06</span>
          <span class="nav-card-title">Kirim Masukan</span>
          <span class="nav-card-description">Sampaikan pertanyaan atau masukan mengenai website.</span>
          <span class="nav-card-link">Buka formulir <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="fitur">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Empat prinsip WCAG</p>
        <h2>Mengenal prinsip POUR</h2>
        <p>Jurnal membahas aksesibilitas melalui empat prinsip yang menjadi dasar penyusunan konten dan antarmuka web.</p>
      </div>

      <div class="principle-grid">
        <% prinsip.forEach(function (p) { %>
          <article class="content-card principle-card">
            <span class="principle-letter" aria-hidden="true"><%= p.huruf %></span>
            <h3><%= p.nama %></h3>
            <p><%= p.deskripsi %></p>
            <span class="tag"><%= p.contoh %></span>
          </article>
        <% }); %>
      </div>

      <div class="section-action">
        <a class="text-link" href="/ulasan">Baca penjelasan lengkap prinsip POUR <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading section-heading-row">
        <div>
          <p class="eyebrow">Data dari PostgreSQL</p>
          <h2>Produk pendukung aksesibilitas</h2>
          <p>Contoh materi dan alat bantu yang tersimpan di database project.</p>
        </div>
        <a class="btn btn-outline-custom" href="/produk">Kelola semua produk</a>
      </div>

      <div class="product-preview-grid">
        <% if (produk.length === 0) { %>
          <p class="empty-state">Belum ada data produk. Buka halaman Kelola Produk untuk menambahkan data.</p>
        <% } %>
        <% produk.forEach(function (item) { %>
          <article class="content-card product-preview">
            <span class="tag"><%= item.kategori %></span>
            <h3><%= item.nama %></h3>
            <p><%= item.deskripsi %></p>
            <strong>Rp <%= Number(item.harga).toLocaleString("id-ID") %></strong>
          </article>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container status-layout">
      <div>
        <p class="eyebrow eyebrow-light">Pemeriksaan backend</p>
        <h2>Status aplikasi</h2>
        <p>Bagian ini mengambil status server dari endpoint <code>/api/status</code>.</p>
        <a class="btn btn-light-custom" href="/api/status" target="_blank" rel="noopener">Buka JSON status</a>
      </div>
      <div class="status-panel">
        <div class="status-panel-heading">
          <strong>GET /api/status</strong>
          <span class="status-indicator" id="status-label">Memeriksa...</span>
        </div>
        <pre id="status-output" aria-live="polite">Memuat response server...</pre>
      </div>
    </div>
  </section>

  <section class="section" id="kontak">
    <div class="container contact-layout">
      <div>
        <p class="eyebrow">Hubungi kelompok</p>
        <h2>Kirim masukan</h2>
        <p>Gunakan formulir ini untuk menyampaikan pertanyaan atau masukan tentang isi website.</p>
        <p class="small-note">Catatan: formulir ini masih berupa simulasi. Pesan belum disimpan ke database atau dikirim ke email.</p>
      </div>

      <form class="contact-form" id="feedback-form">
        <div class="form-field">
          <label for="nama">Nama</label>
          <input id="nama" name="nama" type="text" autocomplete="name" required>
        </div>
        <div class="form-field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required>
        </div>
        <div class="form-field">
          <label for="topik">Topik</label>
          <select id="topik" name="topik">
            <option value="jurnal">Pertanyaan tentang jurnal</option>
            <option value="aksesibilitas">Masalah aksesibilitas website</option>
            <option value="lainnya">Lainnya</option>
          </select>
        </div>
        <div class="form-field">
          <label for="pesan">Pesan</label>
          <textarea id="pesan" name="pesan" rows="4" required></textarea>
        </div>
        <button class="btn btn-primary-custom" type="submit">Kirim masukan</button>
        <p id="feedback-status" class="feedback-status" role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </section>
</main>

<script src="/js/home.js" defer></script>
<%- include("partials/footer", { anggota: anggota }) %>
